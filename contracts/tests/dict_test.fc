#include "../imports/dict.fc";
#include "../imports/stdlib.fc";

const int GAS_LIMIT = 950000;

(slice, slice) load_ref_slice(slice s) asm "LDREFRTOS";
(slice, slice, int) dict_get_min?(cell dict, int key_len) asm (-> 1 0 2) "DICTMIN" "NULLSWAPIFNOT2";
(slice, slice, int) dict_get_next?(cell dict, int key_len, slice pivot) asm(pivot dict key_len -> 1 0 2) "DICTGETNEXT" "NULLSWAPIFNOT2";

() check_one(slice in_msg_body) impure inline {
    slice dict = in_msg_body~load_ref_slice();
    slice key = in_msg_body~load_ref_slice();
    slice expected = in_msg_body~load_ref_slice();
    slice actual = dict.aug_dict_get(key);
    throw_unless(101, equal_slices_bits(actual, expected));
}

() check_full(slice in_msg_body) impure inline {
    cell d = in_msg_body~load_ref();
    slice dict = d.begin_parse();
    int key_len = in_msg_body~load_uint(32);
    slice key = in_msg_body~load_bits(key_len);
    slice val = null();
    int flag = 0;
    if (key.preload_uint(key_len) == 0) {
        ;; first tx
        (key, val, flag) = d.dict_get_min?(key_len);
    } else {
        ;; self tx
        (key, val, flag) = d.dict_get_next?(key_len, key);
    }
    while (flag) {
        slice actual = dict.aug_dict_get(key);
        throw_unless(101, equal_slices_bits(actual, val));
        if (gas_consumed() > GAS_LIMIT) {
            cell msg = begin_cell()
                .store_msg_flags_and_address_none(NON_BOUNCEABLE)
                .store_slice(my_address())
                .store_coins(0)
                .store_prefix_only_body()
                .store_op(0x2)
                .store_ref(d)
                .store_uint(key_len, 32)
                .store_slice(key)
                .end_cell();
            send_raw_message(msg,SEND_MODE_CARRY_ALL_REMAINING_MESSAGE_VALUE);
            return ();
        }
        (key, val, flag) = d.dict_get_next?(key_len, key);
    }
}

() recv_internal(int my_balance, int msg_value, cell in_msg_full, slice in_msg_body) impure {
    if (in_msg_body.slice_empty?()) {
        ;; ignore all empty messages
        return ();
    }

    int op = in_msg_body~load_uint(32);
    if (op == 0x1) {
        check_one(in_msg_body);
    } elseif (op == 0x2) {
        check_full(in_msg_body);
    } else {
        throw(0xffff);
    }
}
