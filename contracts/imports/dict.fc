#include "constants.fc";
#include "stdlib.fc";
#include "utils.fc";

(slice, int, int) read_hml(slice src, int key_len) impure inline {
    ifnot (src~load_bit()) {
        ;; hml_short$0
        int n = src~load_ones();
        src~skip_bits(1);
        int s = src~load_uint(n);
        return (src, s, n);
    }
    ifnot (src~load_bit()) {
        ;; hml_long$10
        int n = src~load_uint(get_bit_size(key_len));
        int s = src~load_uint(n);
        return (src, s, n);
    }
    ;; hml_same$11
    int v = src~load_bit();
    int n = src~load_uint(get_bit_size(key_len));
    int s = (v << n) - v;
    return (src, s, n);
}

slice aug_dict_get(slice src, slice key) impure inline {
    int key_len = key.slice_bits();
    while (key_len >= 0) {
        (src, int prefix, int len) = read_hml(src, key_len);
        throw_unless(error::key_not_found, key~load_uint(len) == prefix);
        key_len -= len;
        if (key_len == 0) {
            return src;
        }
        int ref_idx = key~load_bit();
        src = src.load_ref_n(ref_idx).begin_parse();
        key_len -= 1;
    }
    throw(error::key_not_found);
    return null();
}

slice bintree_search(slice cs) impure inline {
    while (cs~load_bit()) {
        (slice left, int exotic) = cs~load_ref().begin_parse_exotic();
        cs = exotic ? cs~load_ref().begin_parse() : left;
    }
    return cs;
}
